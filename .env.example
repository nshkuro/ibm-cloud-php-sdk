# IBM Cloud PHP SDK Environment Configuration
# ============================================

# IBM Cloud API Key (required for real API calls)
# Get your API key from: https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=your-ibm-cloud-api-key-here

# IBM Cloud Object Storage Configuration
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_SERVICE_INSTANCE_ID=your-service-instance-id

# IBM WatsonX AI Configuration
# Get your project ID from: https://dataplatform.cloud.ibm.com/projects
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_PROJECT_ID=your-watsonx-project-id

# Alternative WatsonX endpoints (choose based on your region)
# IBM_WATSONX_URL=https://eu-gb.ml.cloud.ibm.com     # Europe (London)
# IBM_WATSONX_URL=https://jp-tok.ml.cloud.ibm.com    # Asia Pacific (Tokyo)
# IBM_WATSONX_URL=https://eu-de.ml.cloud.ibm.com     # Europe (Frankfurt)

# Logging and Debug
LOG_LEVEL=DEBUG
ENABLE_REQUEST_LOGGING=true

# Testing Configuration
TEST_BUCKET_NAME=my-sdk-test-bucket