{
    "name": "nshkuro/ibm-cloud-php-sdk",
    "description": "Modern PHP SDK for IBM Cloud Services with enterprise-grade features",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["ibm", "cloud", "sdk", "watsonx", "ai", "object-storage", "document-intelligence"],
    "authors": [
        {
            "name": "Nikolay Shkuro",
            "email": "nikolay@shkuro.net",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "psr/log": "^3.0",
        "psr/cache": "^3.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-client": "^1.0",
        "symfony/yaml": "^6.2|^7.0",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.5",
        "phpstan/phpstan": "^1.10|^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "symfony/var-dumper": "^6.2|^7.0"
    },
    "autoload": {
        "psr-4": {
            "IBMCloud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IBMCloud\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "psalm": "psalm"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}